        <typeDescription>
            <name>org.texttechnologylab.annotation.core.Page</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>
                <featureDescription>
                    <name>internalId</name>
                    <description>Numeric ID for internal handling, in most cases assigned by the data bank.</description>
                    <rangeTypeName>uima.cas.Long</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>url</name>
                    <description>URL of the page</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>title</name>
                    <description>Page title</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>screenshots</name>
                    <description>All screenshots taken on the page</description>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.core.Screenshot</elementType>
                </featureDescription>

                <featureDescription>
                    <name>scrollEvents</name>
                    <description>All scroll events recorded on the page</description>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.core.ScrollEvent</elementType>
                </featureDescription>

                <featureDescription>
                    <name>htmlSourceStates</name>
                    <description>HTML source of the page</description>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.core.HtmlSourceState</elementType>
                </featureDescription>

            </features>
        </typeDescription>
        
        <typeDescription>
            <name>org.texttechnologylab.annotation.core.HtmlSourceState</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>

                <featureDescription>
                    <name>internalId</name>
                    <description>Internal ID only unique per session</description>
                    <rangeTypeName>uima.cas.Long</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>html</name>
                    <description>HTML source</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>timestamp</name>
                    <description>Time of taking HTML source</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>

            </features>
        </typeDescription>

        <typeDescription>
            <name>org.texttechnologylab.annotation.core.Screenshot</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>
                <featureDescription>
                    <name>internalId</name>
                    <description>Internal ID only unique per session</description>
                    <rangeTypeName>uima.cas.Long</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>image</name>
                    <description>Screenshot image</description>
                    <rangeTypeName>org.texttechnologylab.annotation.type.Image</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>timestamp</name>
                    <description>Screenshots time of taking</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>


            </features>

        </typeDescription>

