        <typeDescription>
            <name>org.texttechnologylab.annotation.core.ScrollEvent</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>
                <featureDescription>
                    <name>internalId</name>
                    <description>Numeric ID for internal handling, in most cases assigned by the data bank.</description>
                    <rangeTypeName>uima.cas.Long</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>fromCoord</name>
                    <description>Starting coordinate of scroll</description>
                    <rangeTypeName>org.texttechnologylab.annotation.type.Coordinate</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>toCoord</name>
                    <description>Ending coordinate of scroll</description>
                    <rangeTypeName>org.texttechnologylab.annotation.type.Coordinate</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>timestamp</name>
                    <description>Time of the scroll event</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <typeDescription>
            <name>org.texttechnologylab.annotation.core.MousePosition</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>
                <featureDescription>
                    <name>internalId</name>
                    <description>Numeric ID for internal handling, in most cases assigned by the data bank.</description>
                    <rangeTypeName>uima.cas.Long</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>position</name>
                    <description>Mouse position coordinate</description>
                    <rangeTypeName>org.texttechnologylab.annotation.type.Coordinate</rangeTypeName>
                </featureDescription>

                <featureDescription>
                    <name>timestamp</name>
                    <description>Time of recording of the mouse position</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

